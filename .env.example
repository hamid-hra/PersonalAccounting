# ---- Database (تنها چیز لازم) ----
POSTGRES_PASSWORD=change-me-please
# POSTGRES_USER=accounting
# POSTGRES_DB=accounting

# روی پلتفرم ابری معمولاً به‌جای این‌ها یک DATABASE_URL می‌دهند؛ همان کافی است:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- اختیاری ----
# کلید امضای کوکی نشست. خالی بماند، یک‌بار تصادفی ساخته و در دیتابیس ذخیره می‌شود.
# SECRET_KEY=
# مدت اعتبار نشست (روز)
# SESSION_DAYS=30
# پورت روی لوکال‌هاست
# WEB_PORT=8080

# رمز ورود در اولین اجرا از داخل خود برنامه ساخته می‌شود (صفحهٔ «ساخت حساب»).
# کلید سرویس قیمت (BrsApi) هم از صفحهٔ تنظیمات وارد می‌شود. هیچ‌کدام این‌جا نیست.
# رمز را فراموش کردی؟   docker compose exec app python -m app.reset_password
