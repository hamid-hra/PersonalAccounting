# ---- Database ----
POSTGRES_USER=accounting
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=accounting
POSTGRES_PORT=5432

# ---- Backend ----
# رمز ورود به برنامه (حتماً عوض کن)
APP_PASSWORD=change-me-please
# کلید امضای کوکی نشست — با دستور زیر بساز:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# مدت اعتبار نشست (روز)
SESSION_DAYS=30

# ---- مالکیت فایل‌ها ----
# کانتینر با همین کاربر اجرا می‌شود تا فایل‌های داخل data/ برای خودت
# قابل خواندن باشند (آرشیو صورتحساب‌ها و رسیدها).
APP_UID=1000
APP_GID=1000

# ---- قیمت ارز و طلا ----
# BrsApi رایگان است: تا ۱۵۰۰ درخواست در روز، و طلای ۲۴ عیار هم دارد.
# کلید رایگان: https://api.brsapi.ir/Panel/panel.html
# بدون کلید، بخش «بازار و دارایی» خاموش می‌ماند و بقیهٔ برنامه کامل کار می‌کند.
MARKET_PROVIDER=brsapi
BRSAPI_KEY=
BRSAPI_DAILY_QUOTA=1500
BRSAPI_QUOTA_RESERVE=50

# ---- نوسان (گزینهٔ دوم، ۱۲۰ درخواست در ماه) ----
# از navasan.tech کلید بگیر. بدون کلید، بخش «بازار و دارایی» خاموش
# می‌ماند و بقیهٔ برنامه کامل کار می‌کند.
# پلن رایگان ۱۲۰ درخواست در ماه است؛ برنامه خودش شمارش می‌کند و رد نمی‌شود.
NAVASAN_API_KEY=
NAVASAN_MONTHLY_QUOTA=120
NAVASAN_QUOTA_RESERVE=10

# ---- Web ----
# فقط روی لوکال‌هاست منتشر می‌شود
WEB_PORT=8080
