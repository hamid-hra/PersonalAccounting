# این فایل یک قالب است: nginx هنگام بالا آمدن ${BACKEND_HOST} و ${BACKEND_PORT}
# را از متغیرهای محیطی پر می‌کند (پیش‌فرض در Dockerfile: backend:8000).
# روی پلتفرم‌هایی که هر سرویس را جدا اجرا می‌کنند، BACKEND_HOST را برابر
# نام میزبان سرویس بک‌اند بگذار.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 30m;

    # سرآیندهای امنیتی: نه داخل iframe سایت دیگر، نه حدس نوع فایل، نه نشت آدرس
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # اپ تک‌صفحه‌ای: هر مسیری به index برمی‌گردد
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # آدرس بک‌اند در متغیر می‌نشیند تا nginx هنگام شروع منتظر resolve شدنش
        # نماند؛ اگر بک‌اند هنوز بالا نیامده باشد ۵۰۲ می‌دهد نه اینکه خودش بمیرد.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        client_max_body_size 30m;
    }
}
